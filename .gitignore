# Personal Claude Code config. CLAUDE.md IS tracked on purpose — it's the
# contributor guide, and a course about Claude Code should ship a real one.
# These two are per-machine and would leak local paths and permission history.
.claude/settings.local.json
CLAUDE.local.md

# OS/editor junk
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Future PDF/build outputs (generated, not source)
/build/
/dist/
*.pdf.tmp

# Production material — kept locally, never published to the learner repo.
# Instructor notes hold filming cues and runtimes; the distribution plan is a
# working document with open business decisions in it.
/production/

# Video and editing assets never belong here
*.mp4
*.mov
*.prproj
*.fcpbundle

# Student and enrollment data
/students/
*.csv
